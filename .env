# ─────────────────────────────────────────────────────────────
# DECUCARE — НАСТРОЙКИ (.env)
# ─────────────────────────────────────────────────────────────
# Файловете, които започват с точка (като .env), са скрити по подразбиране
# в Windows и Mac.
# Затова ти слагаме този видим текстов файл "env.txt".
#
# Ако пускаш сайта на хостинг (напр. Vercel), копирай тези редове
# в "Environment Variables":
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Паролата за страницата с поръчки (/admin)
ADMIN_PASSWORD=decucare-admin

# Ключ за имейли от Resend (https://resend.com)
RESEND_API_KEY=re_SLvikjaZ_3uKAje9ShKPd4s3zdQcWQUFq

# Имейлът, на който ТИ ще получаваш известия
ORDER_NOTIFY_EMAIL=trayot@yahoo.com

# От кого идва имейлът
EMAIL_FROM=DecuCare <onboarding@resend.dev>
